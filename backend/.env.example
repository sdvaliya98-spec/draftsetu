# ==========================================================
# DraftSetu / TheLegalSetu Backend Environment Variables Example
# ==========================================================

ENV=development
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///backend/data/document_system.db

WALLET_ENABLED=true
SIGNUP_BONUS_CREDITS=100
DEFAULT_CREDIT_COST=10
SUPPORT_WHATSAPP_NUMBER=919999999999
SUPPORT_UPI_ID=legalsetu@upi

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Zoho SMTP Email Configuration
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=your_zoho_email@yourdomain.com
SMTP_PASSWORD=your_zoho_application_password
SMTP_FROM_EMAIL=your_zoho_email@yourdomain.com
SMTP_FROM_NAME=DraftSetu
