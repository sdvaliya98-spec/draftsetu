# ==========================================
# DraftSetu - Production Gitignore Profile
# ==========================================

# --- Environment Variables & Secrets ---
.env
*.env
.env.*
backend/.env
!backend/.env.example

# --- Databases, WAL & Binary Dumps ---
*.db
*.db-shm
*.db-wal
*.dump
database.db
document_system.db
postgres_data/
postgres_bin/

# --- Python Virtual Environments & Bytecode ---
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tox/
htmlcov/
.coverage

# --- Node / Frontend Artifacts ---
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing, E2E & Report Directories ---
playwright-report/
test-results/
cypress/
tests/
playwright.config.js
cypress.config.js

# --- IDE, AI & Agent Scratch Workspaces ---
.vscode/
.idea/
.agent/
.project
.pydevproject
.DS_Store
Thumbs.db
graphify-out/
scratch/

# --- Dynamic Uploads, Generated Documents & Backups ---
backend/uploads/outputs/*
backend/uploads/temp_previews/*
backend/uploads/temp_renders/*
backend/uploads/*.docx
backend/backups/
uploads/
backups/

# --- Logs & Temporary Files ---
*.log
backend.log
~$*
dummy.txt
test.docx
test.html
templates_out.json
public/test.docx
*_temp_check*
scripts/test_*.py
*.png
